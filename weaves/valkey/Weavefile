# Valkey for one client app: a cache or a small store, from Ubuntu's packages.
#   subweave run valkey "cache for acme-shop, 2048 MB, private network" --on root@acme-cache --name acme-cache

ABOUT  "Valkey as a cache or a small store, from Ubuntu's packages"
FROM   ubuntu:24.04
NEEDS  1 CPU, 2 GB RAM, 20 GB DISK

# ── What a request chooses ─────────────────────────────

ARG role=cache
    cache      "a cache: no persistence; evicts the least recently used keys when full"
    store      "a store: append-only file; never evicts; refuses writes when full"
ARG memory=1024
    <memory>   "memory for data, in megabytes"
ARG access=local
    local      "connections from this box only"
    private    "connections from the private network, with a password"
ARG copies=none
    none       "no copies off the box"
    <copies>   "an scp destination for nightly copies, like backup@10.0.0.9:/srv/valkey/acme"

# valkey-cli reads VALKEYCLI_AUTH
SECRET VALKEYCLI_AUTH "the password that clients send with AUTH"

# ── What the box shows ─────────────────────────────────

FACT valkey     command -v valkey-server
FACT up         valkey-cli ping | grep -qx PONG
FACT max        valkey-cli config get maxmemory | tail -1
FACT policy     valkey-cli config get maxmemory-policy | tail -1
FACT aof        valkey-cli config get appendonly | tail -1
FACT auth_on    [ -n "$(valkey-cli config get requirepass | tail -1)" ]
FACT local_only ! ss -ltnH 'sport = :6379' | awk '$4 !~ /^(127\.0\.0\.1|\[::1\]):/' | grep -q .
FACT used       valkey-cli info memory | awk -F: '/^used_memory:/ {print $2}'
FACT aof_ok     valkey-cli info persistence | grep -q '^aof_last_write_status:ok'
FACT rejected   valkey-cli info stats | awk -F: '/^rejected_connections:/ {print $2}'
FACT logs       FOLLOW tail -F /var/log/valkey/valkey-server.log | grep --line-buffered ' # '

# ── What must hold ─────────────────────────────────────

GOAL installed                                valkey
GOAL running    AFTER installed               up
GOAL sized      AFTER running \
     max == memory * 1048576 AND \
     ((role == 'cache' AND policy == 'allkeys-lru' AND aof == 'no') OR \
      (role == 'store' AND policy == 'noeviction'  AND aof == 'yes'))
GOAL guarded    AFTER running \
     (access == 'local' AND local_only) OR (access == 'private' AND auth_on)
GOAL room       AFTER running   EVERY 5m      role == 'cache' OR used < max * 0.9
GOAL persisted  AFTER running   EVERY 5m      role == 'cache' OR aof_ok
GOAL accepting  AFTER running   EVERY 5m      rejected == PREV(rejected)
GOAL copied     AFTER running                 copies == 'none' OR SINCE(backup) < 25h
GOAL quiet      AFTER running   EVERY 15m \
     "the new lines in `logs` show nothing that needs action"

# ── What the loop may do ───────────────────────────────

ACTION install FOR installed
  WHEN "valkey-server is missing"
  RUN  apt-get install -y valkey-server

ACTION size FOR sized
  WHEN "memory, eviction or persistence differ from the role"
  RUN <<EOF
    valkey-cli config set maxmemory ${memory}mb
    if [ "$role" = cache ]; then
      valkey-cli config set maxmemory-policy allkeys-lru appendonly no
    else
      valkey-cli config set maxmemory-policy noeviction appendonly yes
    fi
    valkey-cli config rewrite
  EOF

ACTION guard FOR guarded
  WHEN "the password or the listening addresses differ from access '$access'"
  DO <<EOF
    Access is '$access'.
    local: valkey listens on 127.0.0.1 and ::1 only.
    private: it also listens on this box's private address,
    and requires the password in $VALKEYCLI_AUTH.
    Save with CONFIG REWRITE.
  EOF

ACTION restart FOR running, accepting
  WHEN "valkey-server crashed or hangs"
  RUN  systemctl restart valkey-server

ACTION raise-clients FOR accepting
  WHEN "connections are rejected while memory has room"
  RUN  n=$(valkey-cli config get maxclients | tail -1) && \
       valkey-cli config set maxclients $(( n * 3 / 2 ))
  RUN  valkey-cli config rewrite

ACTION rewrite-aof FOR persisted
  WHEN "AOF writes failed, and disk space came back"
  RUN  valkey-cli bgrewriteaof

ACTION backup FOR copied
  WHEN "the last copy is older than a day"
  RUN  f=/var/backups/valkey-$(date +%F).rdb && valkey-cli --rdb "$f" && scp -q "$f" "$copies/"
  RUN  find /var/backups -name 'valkey-*.rdb' -mtime +3 -delete

ACTION fix
  WHEN "no other action fits, or the fitting ones already failed"
  DO   "make the failing goal hold again without deleting keys"

# ── Rules ──────────────────────────────────────────────

NEVER "flush or delete keys"
NEVER "turn off the password"
NEVER "open port 6379 to the internet"
# A cold cache sends every read to the client's database.
ASK   BEFORE restart IF role == 'cache' AND used > 1073741824
ASK   IF role == 'store' AND copies == 'none'
