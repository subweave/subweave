# An Ethereum node: reth for execution, lighthouse for consensus. No validator.
#   subweave run ethereum "full node holding only 1000 blocks"

ABOUT  "Ethereum node: reth for execution, lighthouse for consensus, no validator"
FROM   ubuntu:24.04
NEEDS  8 CPU, 32 GB RAM, 2 TB DISK
MODEL  CODE deepseek/deepseek-v4-flash-0731 THEN deepseek/deepseek-v4-pro

# ── What a request chooses ─────────────────────────────

ARG network=mainnet
    mainnet               "Ethereum mainnet"
    sepolia               "the Sepolia testnet"
    hoodi                 "the Hoodi testnet"
ARG history=full
    archive               "every historical state; about 3 TB on mainnet"
    full                  "all blocks and receipts, recent state only"
    last <blocks> blocks  "prune everything older than this many blocks"
ARG rpc=local
    local                 "JSON-RPC on localhost only"
    private               "JSON-RPC on the private network"

# ── What the box shows ─────────────────────────────────

FACT clients     command -v reth && command -v lighthouse
FACT up          systemctl is-active -q reth lighthouse
FACT head        curl -s localhost:8545 -H 'content-type: application/json' \
                   -d '{"jsonrpc":"2.0","id":1,"method":"eth_blockNumber"}' \
                   | jq -r .result | xargs printf '%d'
FACT peers       curl -s localhost:8545 -H 'content-type: application/json' \
                   -d '{"jsonrpc":"2.0","id":1,"method":"net_peerCount"}' \
                   | jq -r .result | xargs printf '%d'
FACT behind      curl -s localhost:5052/eth/v1/node/syncing | jq -r .data.sync_distance
FACT engine_open ss -ltnH 'sport = :8551' | awk '$4 !~ /^(127\.0\.0\.1|\[::1\]):/' | wc -l
FACT disk        df --output=pcent /var/lib/eth | tail -1 | tr -dc 0-9
FACT outdated <<EOF
  for c in paradigmxyz/reth:reth sigp/lighthouse:lighthouse; do
    tag=$(curl -s https://api.github.com/repos/${c%%:*}/releases/latest | jq -r .tag_name)
    ${c##*:} --version | grep -q "${tag#v}" || echo "${c##*:}"
  done | wc -l
EOF
FACT releases <<EOF
  for r in paradigmxyz/reth sigp/lighthouse; do
    curl -s https://api.github.com/repos/$r/releases/latest \
      | jq -c --arg r $r '{repo: $r, tag_name, notes: .body[:1500]}'
  done
EOF
FACT logs        FOLLOW journalctl -f -u reth -u lighthouse \
                   | grep --line-buffered -E 'WARN|ERRO|CRIT'

# ── What must hold ─────────────────────────────────────

GOAL installed                                clients
GOAL running   AFTER installed                up
GOAL sealed    AFTER running                  engine_open == 0
GOAL room      AFTER installed  EVERY 5m      disk < 85
GOAL peered    AFTER running    EVERY 5m      peers >= 5
GOAL synced    AFTER running    EVERY 10m     behind < 64
GOAL moving    AFTER synced     EVERY 5m      head > PREV(head)
GOAL current   AFTER synced     EVERY 1d      outdated == 0
GOAL quiet     AFTER running    EVERY 15m \
     "the new lines in `logs` show nothing that needs action"

# ── What the loop may do ───────────────────────────────

ACTION install FOR installed
  WHEN "reth or lighthouse is missing"
  DO <<EOF
    Install the latest reth and lighthouse releases from GitHub, after checking their signatures.
    Run them as the systemd services reth and lighthouse: data in /var/lib/eth,
    one JWT secret at /etc/eth/jwt.hex.
    Network: $network. History: $history. JSON-RPC: $rpc.
    Lighthouse starts from a checkpoint.
  EOF

ACTION restart FOR running, moving, quiet
  WHEN "a client crashed, hung or stopped following the chain, and nothing on disk is wrong"
  RUN  systemctl restart reth lighthouse

ACTION seal FOR sealed
  WHEN "port 8551 is open beyond localhost"
  DO   "make reth's engine API listen on 127.0.0.1:8551 only, then restart reth"

ACTION add-peers FOR peered
  WHEN "few peers while the p2p ports 30303 and 9000 are closed"
  RUN  ufw allow 30303 && ufw allow 9000
  RUN  systemctl restart reth lighthouse

ACTION free-disk FOR room
  WHEN "the disk is full of journal files, not of chain data"
  RUN  journalctl --vacuum-size=500M

ACTION update FOR current
  WHEN "the newest release is routine or a security fix"
  DO   "upgrade each client that has a newer release; copy its old binary \
        to /opt/eth/previous first; restart it"

ACTION rollback FOR running, synced, moving
  WHEN "a client broke right after an update"
  RUN  install -m 755 /opt/eth/previous/* /usr/local/bin/
  RUN  systemctl restart reth lighthouse

ACTION resync FOR synced, moving
  WHEN "the database is corrupt and a restart did not fix it"
  RUN  systemctl stop reth lighthouse
  RUN  rm -rf /var/lib/eth/reth /var/lib/eth/lighthouse/beacon
  RUN  systemctl start reth lighthouse

ACTION fix
  WHEN "no other action fits, or the fitting ones already failed"
  DO   "make the failing goal hold again"

# ── Rules ──────────────────────────────────────────────

NEVER "run a validator or hold staking keys"
NEVER "expose the engine API, port 8551, beyond localhost"
ASK   BEFORE resync
# reth keeps 10064 blocks for reorgs by default
ASK   IF blocks < 10064
ASK   "before an upgrade that needs database or config changes"
ASK   "before stopping the node for more than 10 minutes"

# ── What the coder reads ───────────────────────────────

SKILL reth-pruning WHEN "reth prune settings: history kept per segment, full and minimal modes" <<EOF
  | history              | reth flags                                  |
  |----------------------|---------------------------------------------|
  | archive              | none                                        |
  | full                 | --full                                      |
  | last <blocks> blocks | each flag below set to $blocks              |

      --prune.minimum-distance            --prune.sender-recovery.distance
      --prune.transaction-lookup.distance --prune.receipts.distance
      --prune.account-history.distance    --prune.storage-history.distance
      --prune.bodies.distance

  reth keeps 10064 blocks for reorgs by default. Fewer lowers that margin; the person
  already said yes to it. Flag names change between releases: check
  `reth node --help | grep prune` first. Pruned data never comes back without a resync.
EOF

SKILL checkpoint-sync WHEN "starting lighthouse from a recent finalized checkpoint" <<EOF
      lighthouse bn --network $network --datadir /var/lib/eth/lighthouse \
        --execution-endpoint http://127.0.0.1:8551 --execution-jwt /etc/eth/jwt.hex \
        --checkpoint-sync-url <url> --http

  | network | url                                           |
  |---------|-----------------------------------------------|
  | mainnet | https://mainnet.checkpoint.sigp.io            |
  | hoodi   | https://hoodi.checkpoint.sigp.io              |
  | sepolia | https://checkpoint-sync.sepolia.ethpandaops.io |

  More: https://eth-clients.github.io/checkpoint-sync-endpoints/
  The checkpoint applies only to an empty beacon database. Lighthouse backfills old
  blocks after it follows the head.
EOF

SKILL client-upgrades WHEN "upgrading reth and lighthouse, and rolling back" <<EOF
  Assets: reth-<tag>-x86_64-unknown-linux-gnu.tar.gz and
  lighthouse-<tag>-x86_64-unknown-linux-gnu.tar.gz, each with a .asc signature.
  1. Download both files; gpg --verify.
  2. Copy the running binary to /opt/eth/previous/.
  3. install -m 755 the new binary to /usr/local/bin/, restart only that client.
  4. The head must move within 15 minutes.
  Notes that say "migration", "breaking", "re-sync" or "schema": stop; the ASK rule applies.
EOF
