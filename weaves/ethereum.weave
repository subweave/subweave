# ethereum.weave: an Ethereum node that installs, watches, upgrades and repairs itself.
#   subweave run ethereum "full node holding only 1000 blocks"

weave   ethereum 0.1
about   "Ethereum node: reth for execution, lighthouse for consensus"
box     ubuntu 24.04, 4 cpu, 16 GB memory, 2 TB disk
decider typesafe/jev-1.13
coder   deepseek/deepseek-v4-flash-0731
budget  $10 a month

want network = mainnet
  mainnet
  sepolia
  hoodi

want history = full
  archive          "every historical state, about 3 TB on mainnet"
  full             "all blocks and receipts, recent state only"
  last <n> blocks  "prune blocks, receipts and state older than n blocks; reth's default reorg safety margin is 10064 blocks, so n below 10064 lowers it"

want rpc = private
  private          "JSON-RPC on localhost only"
  lan              "JSON-RPC on the private network"
  public           "JSON-RPC open to the internet, rate limited"

never  "run a validator or hold staking keys"
never  "expose the engine API, port 8551, beyond localhost"
always "at least 15% of the data disk is free"
ask    "before lowering a client's reorg safety margin"
ask    "before stopping the node for more than 10 minutes"
ask    "before deleting the node's entire database to resync from zero"

install:
  do  "install the latest stable reth and lighthouse from their GitHub releases and verify their checksums"
  do  "run them as systemd services reth and lighthouse, data in /var/lib/eth, config in /etc/eth, one JWT secret at /etc/eth/jwt.hex"
  do  "configure {network} with history '{history}' and JSON-RPC '{rpc}'; lighthouse uses checkpoint sync"
  run ufw allow 22/tcp && ufw allow 30303 && ufw allow 9000 && ufw --force enable
  ready "the node has peers and its head block moves" within 2h

watch every 1m:
  read head   = curl -s localhost:8545 -H 'content-type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"eth_blockNumber"}' | jq -r .result | xargs printf '%d'
  read peers  = curl -s localhost:8545 -H 'content-type: application/json' -d '{"jsonrpc":"2.0","id":1,"method":"net_peerCount"}' | jq -r .result | xargs printf '%d'
  read behind = curl -s localhost:5052/eth/v1/node/syncing | jq -r .data.sync_distance
  read disk   = df --output=pcent /var/lib/eth | tail -1 | tr -dc 0-9
  read logs   = journalctl -u reth -u lighthouse -p warning --since -5min | tail -40
  match "How is the node?":
    syncing   "the head moves but is behind the network"
    healthy   "in sync with the network"
    stuck     "the head has not moved since the last check"  -> heal
    isolated  "fewer than 3 peers"                           -> heal
    down      "reth or lighthouse is not running"            -> restart

restart:
  run systemctl restart reth lighthouse
  ready "both services run and the head moves" within 10m else -> heal

heal:
  do "the node is {why}: find the cause and fix it; prefer restarts and peer changes over config edits"
  ready "the node is syncing or healthy" within 30m

# Chain data can be downloaded again, so back up only what cannot.
backup every 1d keep 7:
  run tar -czf {backup}/node.tgz /etc/eth /etc/systemd/system/reth.service /etc/systemd/system/lighthouse.service

restore:
  run tar -xzf {backup}/node.tgz -C / && systemctl daemon-reload
  do  "install reth and lighthouse if they are missing, then start both with the restored config"
  ready "the node is syncing" within 30m

upgrade every 1d:
  read running  = reth --version | head -1; lighthouse --version | head -1
  read releases = for r in paradigmxyz/reth sigp/lighthouse; do curl -s https://api.github.com/repos/$r/releases/latest | jq -c '{tag_name, published_at, notes: .body[:1500]}'; done
  match "What do the latest releases mean for this node?":
    current   "both clients run their latest release"
    routine   "a newer release with no deadline"                                    -> update
    urgent    "a newer release needed before a network upgrade, or a security fix"  -> update
    breaking  "a newer release that needs database or config changes"              -> careful

careful:
  ask "A new client release needs database or config changes. Upgrade now?"
  -> update

update:
  -> backup
  do  "upgrade whichever client has a newer release; keep the old binaries in /opt/eth/previous"
  ready "the head moves" within 15m else -> rollback

rollback:
  run install -m 755 /opt/eth/previous/* /usr/local/bin/ && systemctl restart reth lighthouse
  ready "the head moves" within 15m
