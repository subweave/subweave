# postgres.weave: PostgreSQL that tunes, watches, backs up and repairs itself.
#   subweave run postgres "postgres 17 for my shop app, private network only"

weave   postgres 0.1
about   "PostgreSQL server with hourly base backups"
box     ubuntu 24.04, 1 cpu, 1 GB memory, 10 GB disk
decider typesafe/jev-1.13
coder   deepseek/deepseek-v4-flash-0731
budget  $5 a month

want version = latest
  latest   "the newest stable major release"
  <major>  "a specific major release, 14 or newer"

want database = app
  <name>   "the database to create, owned by a role of the same name"

# No default: the person must say it.
want access
  local    "connections from this box only"
  private  "connections from the private network, with a password and TLS"

never  "accept connections from the internet"
never  "drop or truncate a database"
always "at least 20% of the data disk is free"
always "the newest backup is less than 2 hours old"
ask    "before a major version upgrade"

install:
  do  "install PostgreSQL {version} from the official PGDG apt repository"
  do  "tune memory, connections and WAL settings for this box's CPU, memory and disk"
  do  "create role and database {database}; save the role's password in /etc/subweave/postgres.env with mode 600"
  do  "allow {access} connections only"
  ready "postgres accepts connections and SELECT 1 works on {database}" within 15m

watch every 1m:
  read up    = runuser -u postgres -- pg_isready -q && echo up || echo down
  read conns = runuser -u postgres -- psql -tAc "select count(*) from pg_stat_activity"
  read limit = runuser -u postgres -- psql -tAc "show max_connections"
  read slow  = runuser -u postgres -- psql -tAc "select count(*) from pg_stat_activity where state <> 'idle' and now() - query_start > interval '5 minutes'"
  read disk  = df --output=pcent /var/lib/postgresql | tail -1 | tr -dc 0-9
  read logs  = journalctl -u 'postgresql*' -p warning --since -5min | tail -40
  match "How is the database?":
    healthy  "accepts connections, no pressure"
    busy     "connections above 80% of the limit, or queries running for over 5 minutes"  -> relieve
    down     "not accepting connections"                                                -> restart

restart:
  run systemctl restart postgresql
  ready "postgres accepts connections" within 5m else -> heal

relieve:
  do "find what holds connections or runs long; end sessions idle in a transaction for over 10 minutes; leave the rest"

heal:
  do "postgres is {why}: find the cause and fix it without losing data"
  ready "postgres accepts connections" within 20m

backup every 1h keep 48:
  run chown postgres {backup} && runuser -u postgres -- pg_basebackup -D {backup} -Ft -z -X stream

restore:
  run systemctl stop postgresql
  do  "move the data directory aside, then restore the base backup in {backup} into a fresh data directory"
  run systemctl start postgresql
  ready "postgres accepts connections and {database} has its tables" within 20m

patch every 7d:
  read pending = apt list --upgradable 2>/dev/null | grep -i postgresql
  if "a PostgreSQL minor update is pending":
    -> backup
    run apt-get install -y --only-upgrade 'postgresql-*'
    ready "postgres accepts connections" within 5m else -> heal
